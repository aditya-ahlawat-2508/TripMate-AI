# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection used for LangGraph's checkpointer (conversation state).
# Local dev example: postgresql://postgres:postgres@localhost:5432/travel_db
# Hosted (Render/Neon/etc.) example: postgresql://user:pass@host:5432/db
# sslmode=require is added automatically for non-localhost hosts; add it
# yourself if you need it for a local host too.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_db

# Groq (LLM inference) — https://console.groq.com
GROQ_API_KEY=

# AviationStack (flight schedules/status — NOT fares) — https://aviationstack.com
# Read from .env as AVIATIONSTACK_API_KEY, passed to the MCP subprocess as
# AVIATION_STACK_API_KEY (with the underscore). Both spellings are load-bearing.
AVIATIONSTACK_API_KEY=

# Tavily (hotel/web search) — https://tavily.com
TAVILY_API_KEY=

# Weather is powered by Open-Meteo, which is free and keyless — no variable needed.

# Default origin airport (IATA) used only when a request names a destination
# but no origin. Set this to whatever makes sense for you; DAC/DEL are just
# examples from the original tutorial.
DEFAULT_ORIGIN_IATA=DEL
