# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection used for LangGraph's checkpointer (conversation state).
# Local dev example: postgresql://postgres:postgres@localhost:5432/travel_db
# Hosted (Render/Neon/etc.) example: postgresql://user:pass@host:5432/db
# sslmode=require is added automatically for non-localhost hosts; add it
# yourself if you need it for a local host too.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/travel_db

# Groq (LLM inference) — https://console.groq.com
GROQ_API_KEY=

# AviationStack (flight schedules/status — NOT fares) — https://aviationstack.com
# Read from .env as AVIATIONSTACK_API_KEY, passed to the MCP subprocess as
# AVIATION_STACK_API_KEY (with the underscore). Both spellings are load-bearing.
AVIATIONSTACK_API_KEY=

# Tavily (hotel/web search) — https://tavily.com
TAVILY_API_KEY=

# Weather is powered by Open-Meteo, which is free and keyless — no variable needed.

# Default origin airport (IATA) used only when a request names a destination
# but no origin. Set this to whatever makes sense for you; DAC/DEL are just
# examples from the original tutorial.
DEFAULT_ORIGIN_IATA=DEL

# Duffel (flight fares) — https://duffel.com. Self-serve signup; use a
# duffel_test_... key for development.
DUFFEL_API_KEY=

# LiteAPI (hotel rates) — https://liteapi.travel. Not implemented yet
# (providers/stays.py's LiteAPIStayProvider is a stub) — setting this alone
# does nothing until that's built.
LITEAPI_KEY=

# Clerk (auth) — https://clerk.com. CLERK_ISSUER is the Frontend API host
# encoded in the publishable key: base64-decode the part after "pk_test_"
# (or pk_live_) up to the trailing "$" to get it. See apps/api/auth.py.
CLERK_SECRET_KEY=
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Razorpay (payments, test mode) — https://razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set only after creating a webhook in the Razorpay dashboard pointing at
# POST /api/billing/webhook on a publicly reachable URL — this is a
# separate secret from the API key pair above.
RAZORPAY_WEBHOOK_SECRET=

# Langfuse (LLM tracing) — https://langfuse.com
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Redis (provider response caching — plumbing exists in providers/cache.py,
# not yet wired into any provider). Matches infra/docker-compose.yml.
REDIS_URL=redis://localhost:6379/0
