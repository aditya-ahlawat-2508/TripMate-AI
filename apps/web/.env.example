# Copy to .env.local and fill in real values. Never commit .env.local.

NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk (auth) — https://clerk.com. Publishable key is safe client-side.
# CLERK_SECRET_KEY here is Next.js's own server-side copy (middleware,
# auth() in server components) — separate from the same key set in
# apps/api/.env for FastAPI's JWT verification; they're different
# processes and don't share environment variables.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# PostHog (analytics) — https://posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
